# Copie este arquivo para `.env` e preencha com os dados do SEU projeto Supabase.
# Painel do Supabase > Project Settings > Data API (URL) e API Keys (chave anon/publishable).
#
# A chave anon e publica por design: quem protege os dados sao as politicas de RLS
# definidas em supabase/schema.sql.
#
# Toda variavel lida pelo app precisa comecar com EXPO_PUBLIC_.
# Depois de editar o .env, reinicie o bundler com: npx expo start --clear

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-sua-chave-anon

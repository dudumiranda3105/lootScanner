{
  "expo": {
    "name": "LootScanner",
    "slug": "lootscanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dudumiranda.lootscanner",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dudumiranda.lootscanner",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "O LootScanner usa a câmera para fotografar o item achado e catalogá-lo."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O LootScanner acessa suas fotos para você escolher a imagem do item achado."
        }
      ],
      "expo-image",
      "expo-splash-screen",
      "expo-font"
    ],
    "scheme": "lootscanner",
    "experiments": {
      "typedRoutes": true
    },
    "description": "Achados e perdidos com cara de RPG. Fotografe o objeto encontrado, registre em segundos e publique no mural para quem perdeu encontrar.",
    "primaryColor": "#E8B84B"
  }
}
